{
  "manifest_version": 3,
  "name": "TraceCheck Deep Scan",
  "version": "0.2.0",
  "description": "Opt-in local cookie metadata scan for TraceCheck. Cookie values are never sent to the page.",
  "permissions": ["cookies", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://tracecheck-eus.pages.dev/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "TraceCheck Deep Scan" }
}
